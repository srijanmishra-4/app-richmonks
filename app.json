{
  "expo": {
    "name": "RichMonks",
    "slug": "richmonks-app",
    "scheme": "richmonks",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/icon.png"
      },
      "package": "com.richmonks.richmonksapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./src/assets/fonts/Inter_400Regular.ttf",
              "./src/assets/fonts/Inter_500Medium.ttf",
              "./src/assets/fonts/Inter_600SemiBold.ttf",
              "./src/assets/fonts/Inter_700Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#DCEFFB"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95f396c3-9ab2-4d52-90f7-7093d306a807"
      }
    }
  }
}
